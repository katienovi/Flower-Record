<%- include('./partials/navbar') %>
            <div id="root">

            <div class="card-wrapper">
                 <% flowers.forEach((flower)=> { %>
                                <div class="card">
                                    <div class="container">
                                        <h4><b><%= flower.name %></b></h4> 
                                        <h4>Entry #<%= flower.id %></h4>
                                        <h6>Location: <%= flower.location %></h6> 
                                        <p><%= flower.description %></p>
                                        <button class="delete-btn" id="<%= flower.id %>">
                                            <img id ="delete-img" src="/Images/delete-icon.png" alt="Delete">
                                        </button>
                                    </div>
                                </div>
                            <% }) %>
            </div>

            </div>

    </body>
</html>